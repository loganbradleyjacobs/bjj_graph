    "Straight Arm Lock": {
      "type": "Submission"
    },
    "Armbar": {
      "type": "Submission",
      "area": [
        "Ground"
      ],
      "notes": "Finishing:\n- Strip any grip on your leg before extending\n- Knees pinched, heel tight to their armpit\n- Bridge hips up, pull the wrist to your chest\n- Thumb up, elbow down, squeeze\n\nExpected defenses:\n- Hitchhiker roll if they commit to escaping\n- Stack if they are strong enough to compress\n- If either lands, reset to Spiderweb or transition"
    },
    "Mounted Americana": {
      "type": "Submission"
    },
    "Rear Naked Choke": {
      "type": "Submission"
    },
    "Clock Choke": {
      "type": "Submission"
    },
    "Cross Collar Choke": {
      "type": "Submission"
    },
    "Arm Triangle": {
      "type": "Submission"
    },
    "Ezekiel": {
      "type": "Submission"
    },
    "Chair Sit Ezekiel": {
      "type": "Submission"
    },
    "Spiderweb": {
      "type": "Predicament",
      "area": [
        "Ground"
      ],
      "notes": "Retention:\n- Leg heavy across the neck, foot on the hip\n- Stay on your side, not flat on your back\n- Knees pinched, their arm trapped between them\n- If they posture, follow with your hips, not your arms\n\nEscapes to expect:\n- Stack defense (they drive forward to compress you)\n- Hand-fight the wrist, extract the arm, recover\n- Hitchhiker roll once the arm starts extending (see Armbar)"
    }
  },
  "moves": [
    {
      "name": "Double Leg Takedown",
      "type": "Takedown",
      "from": [
        "Standing"
      ],
      "to": [
        "Top Half Guard",
        "Top Full Guard",
        "Top Side Control"
      ],
      "area": [
        "Standing",
        "Clinch"
      ],
      "notes": "Level change first, then shoot. Lead knee to the mat between their feet, head to the outside hip (never the inside - guillotine). Hands on the backs of the knees, pull the ankles out, finish with a lift and turn. If they sprawl, keep your hips under you and circle up rather than reaching for a bad shot."
    },
