    "Mounted Triangle": {
      "type": "Submission",
      "notes": "Finishing:\n- Triangle lock with the ankle behind the knee, from Mount\n- Stay upright, head over their trapped shoulder\n- Do not get rolled forward - your weight is the advantage\n\nIf they defend or build posture:\n- Roll over the trapped shoulder into a standard Triangle\n- The lock stays; the position becomes a guard triangle"
    },
    "Mounted Kimura": {
      "type": "Submission"
    },
    "Mounted Straight Arm Lock": {
      "type": "Submission"
    },
    "Bottom Knee Shield": {
      "type": "Guard"
    },
    "Triangle": {
      "type": "Submission",
      "notes": "Finishing:\n- Standard guard triangle: lock, angle off, pull the head down\n- Adjust the lock so the crook of the knee is over the ankle\n- Squeeze and angle to finish\n\nEntry:\n- One arm and the head inside your legs (thrown up from guard)"
    },
    "Rear Triangle": {
      "type": "Submission"
    },
    "Top Kimura": {
      "type": "Submission"
    },
    "Bottom Kimura": {
      "type": "Submission"
